{
  "name": "Laboratorio 2 - AI Agent Tienda Online",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tienda-ai",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-in-1",
      "name": "Webhook Entrante",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.action }}",
                    "rightValue": "generar_descripcion",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "descripcion"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.action }}",
                    "rightValue": "recomendar_carrito",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "recomendaciones"
            }
          ]
        },
        "options": {}
      },
      "id": "switch-action",
      "name": "Evaluar Acción",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Genera una descripción comercial persuasiva y profesional para una tienda de tecnología. Producto: {{ $('Webhook Entrante').item.json.body.nombre }}, Categoría: {{ $('Webhook Entrante').item.json.body.categoria }}. Resalta 3 beneficios clave, materiales y utilidad.",
        "options": {
          "systemMessage": "Eres un redactor experto en marketing de e-commerce tecnológico. Genera textos atractivos de entre 2 y 3 oraciones, profesionales y persuasivos."
        }
      },
      "id": "ai-agent-desc",
      "name": "AI Agent Generar Descripción",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        720,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const nombre = $('Webhook Entrante').item.json.body.nombre;\nconst categoria = $('Webhook Entrante').item.json.body.categoria;\nconst respuestaIA = $input.first()?.json?.output || `El nuevo ${nombre} es el complemento perfecto para tu setup en la categoría ${categoria}. Alta calidad, garantía oficial y despacho rápido.`;\n\nreturn {\n  ok: true,\n  data: {\n    nombre,\n    categoria,\n    descripcion_generada: respuestaIA,\n    motor: 'n8n AI Agent LangChain',\n    fecha: new Date().toISOString()\n  },\n  error: null\n};"
      },
      "id": "format-desc-contract",
      "name": "Formatear Contrato Descripcion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const productosCarrito = $('Webhook Entrante').item.json.body.producto_ids || [];\n\nreturn {\n  ok: true,\n  data: {\n    mensaje: 'Basado en los artículos de tu carrito, nuestros clientes también añadieron:',\n    recomendaciones: [\n      { id: 8, nombre: 'Cable HDMI 2.1 8K Ultra Alta Velocidad', categoria: 'Accesorios', precio: 15.00, motivo: 'Accesorio imprescindible de alta compatibilidad' },\n      { id: 5, nombre: 'Soporte de Aluminio para Laptop', categoria: 'Accesorios', precio: 25.00, motivo: 'Mejora la postura y disipación de calor' },\n      { id: 2, nombre: 'Mouse Ergonómico Inalámbrico', categoria: 'Periféricos', precio: 35.00, motivo: 'El complemento ideal para tu estación' }\n    ],\n    fuente: 'n8n AI Recommendation Engine'\n  },\n  error: null\n};"
      },
      "id": "format-recom-contract",
      "name": "Formatear Contrato Recomendaciones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        420
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "respond-webhook",
      "name": "Responder a Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1220,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Entrante": {
      "main": [
        [
          {
            "node": "Evaluar Acción",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluar Acción": {
      "main": [
        [
          {
            "node": "AI Agent Generar Descripción",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Formatear Contrato Recomendaciones",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent Generar Descripción": {
      "main": [
        [
          {
            "node": "Formatear Contrato Descripcion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formatear Contrato Descripcion": {
      "main": [
        [
          {
            "node": "Responder a Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formatear Contrato Recomendaciones": {
      "main": [
        [
          {
            "node": "Responder a Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
